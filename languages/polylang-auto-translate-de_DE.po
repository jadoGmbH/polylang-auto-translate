#. Plugin Name of the plugin
#: polylang-auto-translate.php
msgid "Polylang Auto Translator"
msgstr "Polylang Auto-Übersetzer"

#. Description of the plugin
#: polylang-auto-translate.php
msgid "Translates content from the original language text using MyMemory/translated.com while preserving the Gutenberg structure."
msgstr "Übersetzt Inhalte aus dem Originaltext unter Verwendung von MyMemory/translated.com unter Beibehaltung der Gutenberg-Struktur."

#. Author of the plugin
#: polylang-auto-translate.php
msgid "jado GmbH"
msgstr "jado GmbH"

#: polylang-auto-translate.php:35
msgid "Polylang Auto Translator requires the Polylang plugin to be installed and active."
msgstr "Polylang Auto Translator erfordert die Installation und Aktivierung des Polylang-Plugins."

#: polylang-auto-translate.php:42
#: polylang-auto-translate.php:58
